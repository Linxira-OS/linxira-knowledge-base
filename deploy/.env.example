# Copy to deploy/.env and edit. `docker compose -f deploy/compose.yaml ...`
# reads this file automatically (the compose file's directory is the project
# directory). deploy/.env is gitignored — never commit real passwords.

# PostgreSQL password used both by the bundled postgres:16 service and by the
# LKB_DATABASE_URL of the lkb service. Keep it URL-safe (no @ : / ? # [ ]
# characters) or percent-encode it, because it is interpolated into a DSN.
LKB_DB_PASSWORD=change-me

# Host port for the nginx front door (SPA + /api reverse proxy).
LKB_HTTP_PORT=8080

# App image tag: <version>, <major.minor>, or latest.
# Example: LKB_IMAGE_TAG=0.2.0
LKB_IMAGE_TAG=latest

# Log level for the lkb service (tracing env-filter).
LKB_LOG_LEVEL=info
