# LKB / WSL PostgreSQL 连接模板（仅占位符；真实密码只存在于本地 pg.env，不进入 git）
# 实际文件位置：
#   WSL:     ~/.config/lkb/pg.env           （0600）
#   Windows: <repo>/.lkb/pg.env             （.gitignore 已忽略；NTFS ACL 仅当前用户）
# 用法（Git Bash）: set -a; source .lkb/pg.env; set +a
LKB_DATABASE_URL=postgres://lkb:REPLACE_WITH_PASSWORD@localhost:5432/lkb
LKB_TEST_PG_URL=postgres://lkb:REPLACE_WITH_PASSWORD@localhost:5432/lkb_test
