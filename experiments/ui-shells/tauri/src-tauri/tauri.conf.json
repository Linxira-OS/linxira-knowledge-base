{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layered KB",
  "version": "0.1.0",
  "identifier": "dev.lkb.shell.tauri-prototype",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Layered KB",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
