{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lkb-desktop",
  "version": "0.2.1",
  "identifier": "com.lkb.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "本地优先的个人知识库桌面版",
    "longDescription": "Linxira 知识库桌面版：内置 lkb 引擎（SQLite 默认，或 PostgreSQL），托管本地 Web UI。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lkb"],
    "resources": ["resources/web"]
  }
}
